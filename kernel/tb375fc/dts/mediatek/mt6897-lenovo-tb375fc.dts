 */

/dts-v1/;
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/iio/adc/mediatek,mt6363-auxadc.h>
#include <dt-bindings/input/gpio-keys.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/spmi/spmi.h>
#include <dt-bindings/usb/pd.h>
#include "mt6897.dtsi"
#include "mt6897-pinfunc.h"

/ {
	model = "Lenovo Xiaoxin Pad Pro 12.7 (TB375FC)";
	compatible = "lenovo,tb375fc", "mediatek,mt6897";

	aliases {
		i2c5 = &i2c5;
		i2c10 = &i2c10;
		serial0 = &uart0;
		spmi0 = &spmi_m;
	};

	sound: sound {
		compatible = "mediatek,mt6897-mt6368-sound";
		model = "TB375FC";
		mediatek,platform = <&afe>;
		audio-routing =
			"Speakers", "Amp0 DAC Output",
			"Speakers", "Amp1 DAC Output",
			"Speakers", "Amp2 DAC Output",
			"Speakers", "Amp3 DAC Output";
		status = "disabled";

		dai-link-0 {
			link-name = "I2SOUT4_BE";
			dai-format = "dsp_b";
			mediatek,clk-provider = "cpu";

			codec {
				sound-dai = <&amp0>, <&amp1>, <&amp2>, <&amp3>;
			};
		};

		dai-link-1 {
			link-name = "ADDA_BE";

			codec {
				sound-dai = <&mt6368_codec>;
			};
		};
	};

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		stdout-path = "serial0:921600n8";

		/*
		 * The bootloader drives the panel over both DSI links with DSC
		 * and scans out one 2944x1840 buffer. The base is the one in the
		 * tree it passes to the vendor kernel (atag,videolfb). The stride
		 * and format are from the community port.
		 */
		framebuffer0: framebuffer@fc16f000 {
			compatible = "simple-framebuffer";
			reg = <0 0xfc16f000 0 (2944 * 1840 * 4)>;
			width = <2944>;
			height = <1840>;
			stride = <(2944 * 4)>;
			format = "a8r8g8b8";
			panel = <&panel0>;
		};
	};

	/*
	 * Hall sensor. GPIO1 (stock hall_1) goes low when the cover closes
	 * over the screen. The stock hall_2 is the keyboard's plug-gpios, under
	 * &uart3. The tablet has no sensor for the keyboard folded back: the
	 * keyboard reports that itself, and its driver turns it into
	 * SW_TABLET_MODE.
	 * Checked on the device: low while a cover is closed. Only opening
	 * wakes the tablet: closing a cover over a sleeping tablet woke it,
	 * and logind ignores the lid for a while after a wakeup, so the
	 * screen stayed on under the cover.
	 */
	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&hall_pins>;

		switch-lid {
			label = "Lid";
			gpios = <&pio 1 GPIO_ACTIVE_LOW>;
			linux,input-type = <EV_SW>;
			linux,code = <SW_LID>;
			debounce-interval = <100>;
			wakeup-source;
			wakeup-event-action = <EV_ACT_DEASSERTED>;
		};
	};

	memory@40000000 {
		device_type = "memory";
		/* The bootloader fills in the real size (8 or 12 GiB) */
		reg = <0 0x40000000 0 0x40000000>;
	};

	/*
	 * The panel's 1.8 V I/O supply behind a switch on GPIO63 (stock
	 * vddio_1v8-gpios), which the touch side of the NT36532 shares. The
	 * bootloader turns it on with the panel, and nothing may turn it off
	 * while the display runs on simple-framebuffer. It stays on with the panel
	 * driver: stock turns it on before the DSI links and off after them, which
	 * the driver cannot do, and turns it on before it reads the panel ID strap.
	 * TODO(2c): enable with pio.
	 */
	vddio_1v8: regulator-vddio-1v8 {
		compatible = "regulator-fixed";
		regulator-name = "vddio_1v8";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		gpio = <&pio 63 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
		regulator-always-on;
		status = "disabled";
	};

	/*
	 * The enables of the panel's bias chip, an SM5109 at 0x3e on i2c13 (stock
	 * bias_p-gpios and bias_n-gpios). The bootloader turns them on and writes
	 * 0x12 to its two voltage registers, and the stock kernel does too. Stock
	 * also waits 80 ms after the panel goes off. The chip does not keep the
	 * voltages while off: it reads 0x0e after the panel comes back. TODO: write
	 * them again at every power on. 5.8 V is the value by the formula of the
	 * TPS65132, which has the same two registers; the SM5109's is not known.
	 */
	lcd_avdd: regulator-lcd-avdd {
		compatible = "regulator-fixed";
		regulator-name = "lcd_avdd";
		regulator-min-microvolt = <5800000>;
		regulator-max-microvolt = <5800000>;
		gpio = <&pio 187 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
		off-on-delay-us = <80000>;
		status = "disabled";
	};

	lcd_avee: regulator-lcd-avee {
		compatible = "regulator-fixed";
		regulator-name = "lcd_avee";
		regulator-min-microvolt = <5800000>;
		regulator-max-microvolt = <5800000>;
		gpio = <&pio 186 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
		off-on-delay-us = <80000>;
		status = "disabled";
	};

	/*
	 * The display PWM of the SoC sets the brightness, as in the stock tree
	 * (mtk-leds, led-mode 5) and the bootloader's log. Its one output dims the
	 * two SGM37604A LED drivers together, at 0x36 on i2c13 and i2c3. The panel
	 * does nothing with DCS 0x51. The bootloader sets up both LED drivers:
	 * current = I2C code x PWM, with their ramp on, and code 0xdb6, which makes
	 * 21.4 mA per string at full duty. They keep it, so they need no driver.
	 *
	 * The period is the one of the stock tree and of the bootloader, which runs
	 * the PWM at 104 MHz. The LED drivers take 20 to 100 kHz. The levels are
	 * percent of lightness by CIE 1931, as in the default table of pwm-backlight.
	 * Level 1 is about the stock minimum of 4, and the default about the
	 * bootloader's 1945.
	 */
	backlight: backlight {
		compatible = "pwm-backlight";
		pwms = <&disp_pwm0 0 39380>;
		brightness-levels = <0 5 9 14 18 23 27 32 36 41
				     46 52 58 64 71 78 86 94 103 112
				     122 133 144 156 168 181 194 209 223 239
				     255 272 290 309 328 348 369 391 413 436
				     461 486 512 539 567 595 625 656 688 720
				     754 789 825 862 900 939 979 1021 1063 1107
				     1152 1198 1245 1293 1343 1394 1447 1500 1555 1611
				     1669 1728 1788 1849 1913 1977 2043 2110 2179 2249
				     2321 2394 2469 2546 2623 2703 2784 2867 2951 3037
				     3125 3214 3305 3397 3492 3588 3686 3785 3887 3990
				     4095>;
		default-brightness-level = <75>;
		status = "disabled";
	};

	/*
	 * Charging through the MT6375, with the values of the stock tree: ieoc,
	 * min-charge-temp, max-charge-temp, and a charge current of 3 A
	 * (sc-charger-current, and what stock takes from a 3 A Type-C current or a
	 * 5 V PD contract). The voltage is the lowest of its battery maintenance
	 * table, which a battery of any age can take (maintenance-v20-level0-cv,
	 * maintenance-v10-level3-cv), not the 4.5 V of battery-cv. Stock has no
	 * over-voltage threshold of its own, so that one is the next step up in the
	 * fuel gauge's column of that table (maintenance-v10-level2-fg-cv). The
	 * charge pump charges faster with the direct_charge parameter of the charger
	 * driver, which is off by default.
	 */
	battery: battery {
		compatible = "simple-battery";
		constant-charge-voltage-max-microvolt = <4340000>;
		constant-charge-current-max-microamp = <3000000>;
		charge-term-current-microamp = <350000>;
		over-voltage-threshold-microvolt = <4410000>;
		operating-range-celsius = <0 50>;
		status = "disabled";
	};

	/*
	 * Turns the USB VBUS boost on and off from user space, through the state
	 * attribute of this device, until the TCPC driver takes that over. Stays
	 * off with the MT6375 (see &i2c5).
	 */
	usb_vbus_output: usb-vbus-output {
		compatible = "regulator-output";
		vout-supply = <&mt6375_otg_vbus>;
		status = "disabled";
	};

	/*
	 * The NTC at the USB connector, on VIN4 of the MT6363 with its 100 kOhm
	 * pull-up (stock usb_board_ntc on vin4-100k). The resistances are the
	 * ones of the stock table. The AUXADC driver hands out the reading times
	 * its full scale, so a value here is 32768 * R / (R + 100000) * 1840.
	 * Steps of one degree also keep the interpolation in the driver in range.
	 */
	usb_conn_ntc: thermal-sensor-usb-conn {
		compatible = "generic-adc-thermal";
		#thermal-sensor-cells = <0>;
		io-channels = <&mt6363_adc MT6363_AUXADC_VIN4>;
		io-channel-names = "sensor-channel";
		temperature-lookup-table = <
			(-40000) 58951760
			(-39000) 58854240
			(-38000) 58751200
			(-37000) 58640800
			(-36000) 58524880
			(-35000) 58401600
			(-34000) 58270960
			(-33000) 58132960
			(-32000) 57985760
			(-31000) 57831200
			(-30000) 57667440
			(-29000) 57494480
			(-28000) 57312320
			(-27000) 57120960
			(-26000) 56920400
			(-25000) 56706960
			(-24000) 56484320
			(-23000) 56248800
			(-22000) 56002240
			(-21000) 55742800
			(-20000) 55472320
			(-19000) 55188960
			(-18000) 54892720
			(-17000) 54583600
			(-16000) 54259760
			(-15000) 53923040
			(-14000) 53571600
			(-13000) 53205440
			(-12000) 52826400
			(-11000) 52430800
			(-10000) 52022320
			(-9000) 51595440
			(-8000) 51155680
			(-7000) 50701200
			(-6000) 50230160
			(-5000) 49744400
			(-4000) 49245760
			(-3000) 48730560
			(-2000) 48200640
			(-1000) 47657840
			0 47098480
			1000 46526240
			2000 45941120
			3000 45341280
			4000 44730400
			5000 44106640
			6000 43470000
			7000 42824160
			8000 42167280
			9000 41501200
			10000 40824080
			11000 40139600
			12000 39449600
			13000 38750400
			14000 38045680
			15000 37337280
			16000 36621520
			17000 35905760
			18000 35184480
			19000 34463200
			20000 33740080
			21000 33018800
			22000 32297520
			23000 31576240
			24000 30860480
			25000 30146560
			26000 29436320
			27000 28729760
			28000 28030560
