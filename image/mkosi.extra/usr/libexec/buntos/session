# buntOS 그래픽 세션을 시작한다. 로그인 화면(bunt-greeter)이 암호를 확인하면 greetd가 그 사용자의
# 세션으로 실행한다. 세션(컴포지터)이 끝나면 로그인 화면이 다시 뜬다.

# 표시 언어. 시스템 설정이 고른 언어를 ~/.config/environment.d/에 적는다 (없으면 /etc/locale.conf, 그것도 없으면 영어)
LANG=$(cat "${XDG_CONFIG_HOME:-$HOME/.config}"/environment.d/*.conf 2>/dev/null | sed -n 's/^LANG=//p' | tail -n 1)
[ -n "$LANG" ] || LANG=$(sed -n 's/^LANG=//p' /etc/locale.conf 2>/dev/null | tail -n 1)
export LANG="${LANG:-en_US.UTF-8}"
export XDG_SESSION_TYPE=wayland
# 앞이 우선인 목록. 뒤의 GNOME은 Chromium·Electron 앱이 비밀 저장소로 GNOME 키링을 고르게 한다
# (모르는 데스크톱이면 평문에 저장한다). 자세한 것은 greeter/src/main.rs의 SESSION_ENV
export XDG_CURRENT_DESKTOP=buntOS:GNOME
export XCURSOR_THEME=Adwaita
export XCURSOR_SIZE=24
# GTK의 렌더러(GSK_RENDERER)는 컴포지터가 자기 렌더러를 보고 정한다. CPU로 그리면 cairo를 주고, GPU가
# 있으면 GTK가 고르게 둔다 (comp/src/gpu.rs). 여기서 정하면 컴포지터는 그 값을 그대로 물려준다

# 앱의 창 단추를 macOS의 신호등으로 그린다. GTK는 시스템 전체에 입힐 CSS를 따로 읽지 않으므로,
# 사용자 CSS가 없을 때만 buntOS 모양을 읽는 사용자 CSS를 만든다. 사용자가 만든 파일은 건드리지 않는다
for version in 3.0 4.0; do
	css="${XDG_CONFIG_HOME:-$HOME/.config}/gtk-$version/gtk.css"
	if [ ! -e "$css" ] && mkdir -p "${css%/*}"; then
		printf '/* buntOS 기본 모양. 지우면 GTK 기본 단추로 돌아간다 */\n@import url("file:///usr/share/buntos/gtk-%s/buntos.css");\n' \
			"$version" >"$css"
	fi
done

exec systemd-cat --identifier=bunt-comp bunt-comp
